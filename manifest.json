{
  "name": "obsidian-blade-mcp",
  "version": "1.0.0",
  "description": "Obsidian vault MCP — Obsidian CLI when the app runs, direct file access when it does not. Read-only by default.",
  "author": "Piers",
  "license": "MIT",
  "runtime": "python",
  "entry_point": "obsidian-blade-mcp",
  "environment_variables": {
    "OBSIDIAN_MCP_WRITES": "1 to register the 12 write tools (default: unset, read-only, 28 tools)",
    "OBSIDIAN_VAULT_PATH": "Vault directory (required for the file backend; write guard on the cli backend)",
    "OBSIDIAN_MCP_BACKEND": "auto|cli|file (default: auto; never launches Obsidian)",
    "OBSIDIAN_VAULT_NAME": "Target vault name (optional if only one vault open)",
    "OBSIDIAN_CLI_PATH": "Path to obsidian binary (auto-detected if empty)",
    "OBSIDIAN_MCP_TRANSPORT": "stdio|http (default: stdio)",
    "OBSIDIAN_MCP_HOST": "127.0.0.1",
    "OBSIDIAN_MCP_PORT": "8766",
    "OBSIDIAN_MCP_API_TOKEN": "Bearer token for HTTP auth. Required for any non-loopback bind, and for writes over HTTP on any bind"
  },
  "tools": [
    "vault_info",
    "vault_read",
    "vault_create",
    "vault_append",
    "vault_prepend",
    "vault_files",
    "vault_file_info",
    "vault_folders",
    "vault_recents",
    "vault_property_read",
    "vault_property_set",
    "vault_property_remove",
    "vault_properties",
    "vault_search",
    "vault_search_context",
    "vault_tags",
    "vault_tag",
    "vault_bases",
    "vault_base_views",
    "vault_base_query",
    "vault_query_properties",
    "vault_section_read",
    "vault_section_replace",
    "vault_outline",
    "vault_links",
    "vault_backlinks",
    "vault_aliases",
    "vault_unresolved",
    "vault_orphans",
    "vault_deadends",
    "vault_tasks",
    "vault_task_update",
    "vault_bookmarks",
    "vault_bookmark_add",
    "vault_delete",
    "vault_rename",
    "vault_move",
    "vault_daily_read",
    "vault_daily_append",
    "vault_template_read"
  ],
  "backends": {
    "cli": "all tools",
    "file": {
      "unsupported": [
        "vault_base_views",
        "vault_base_query",
        "vault_bookmark_add"
      ]
    }
  },
  "safety": {
    "read_only_default": true,
    "write_tools": [
      "vault_append",
      "vault_bookmark_add",
      "vault_create",
      "vault_daily_append",
      "vault_delete",
      "vault_move",
      "vault_prepend",
      "vault_property_remove",
      "vault_property_set",
      "vault_rename",
      "vault_section_replace",
      "vault_task_update"
    ],
    "confirm_required": [
      "vault_delete",
      "vault_rename",
      "vault_move"
    ],
    "hash_precondition_param": "if_hash"
  }
}
