# Vault directory. Required for the file backend (Obsidian closed or absent).
# On the cli backend, writes are refused if the CLI's vault is a different directory.
OBSIDIAN_VAULT_PATH=

# Backend: "auto" (cli if Obsidian is running and the CLI is installed, else file), "cli", or "file"
OBSIDIAN_MCP_BACKEND=auto

# Vault name (used when multiple vaults are open)
OBSIDIAN_VAULT_NAME=

# Path to Obsidian CLI binary (auto-detected if empty)
OBSIDIAN_CLI_PATH=

# Transport: "stdio" (default) or "http"
OBSIDIAN_MCP_TRANSPORT=stdio

# HTTP settings (only when OBSIDIAN_MCP_TRANSPORT=http)
OBSIDIAN_MCP_HOST=127.0.0.1
OBSIDIAN_MCP_PORT=8766

# Bearer token for HTTP auth (disabled if empty)
OBSIDIAN_MCP_API_TOKEN=
